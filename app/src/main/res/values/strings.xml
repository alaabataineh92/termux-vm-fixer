    <string name="vmfix_patcher_title">Patch the Termux app</string>
    <string name="vmfix_patcher_intro">Build a Termux APK that repairs itself when it is installed. No adb and no root are needed - this works entirely inside the app.</string>
    <string name="vmfix_patcher_warning_install_title">Install permission needed</string>
    <string name="vmfix_patcher_warning_install_body">Android requires you to allow "Install unknown apps" for this app before it can install the patched Termux. It is a one-time setting, not root.</string>
