    <string name="vmfix_fix_step_connect_title">Connect</string>
    <string name="vmfix_fix_step_connect_description">Open the channel the repair runs through. This is where a transport problem shows up, before anything on the device is touched.</string>
    <string name="vmfix_fix_step_obtain_apk_title">Read Termux\'s APK</string>
    <string name="vmfix_fix_step_obtain_apk_description">Copy the installed APK, then unpack the bootstrap from inside it. The bootstrap is a zip stored in the APK, so it is read from there rather than downloaded.</string>
    <string name="vmfix_fix_step_build_archive_title">Build the archive and symlink list</string>
    <string name="vmfix_fix_step_build_archive_description">Generate the symlink script, then pack the bootstrap as GNU-format tar - the only format older Android\'s tar can read.</string>
    <string name="vmfix_fix_step_stop_termux_title">Stop Termux</string>
    <string name="vmfix_fix_step_stop_termux_description">Termux is stopped and waited on, so it cannot touch the prefix while it is being rebuilt.</string>
    <string name="vmfix_fix_step_upload_title">Send the files</string>
    <string name="vmfix_fix_step_upload_description">Copy the archive and the scripts to the device. This is the largest single step: the archive is around 70 MB.</string>
    <string name="vmfix_fix_step_rebuild_prefix_title">Rebuild the prefix</string>
    <string name="vmfix_fix_step_rebuild_prefix_description">Clear the old prefix, extract the bootstrap, fix permissions, create the symlinks and run the packages\' own post-install scripts.</string>
    <string name="vmfix_fix_step_install_library_title">Install the library</string>
    <string name="vmfix_fix_step_install_library_description">libvmfix.so and the touch/cp/tar shims are written into the prefix.</string>
    <string name="vmfix_fix_step_install_hooks_title">Install the hooks</string>
    <string name="vmfix_fix_step_install_hooks_description">The login and profile hooks that load the library, and the apt configuration.</string>
    <string name="vmfix_fix_step_repair_symlinks_title">Repair dangling symlinks</string>
    <string name="vmfix_fix_step_repair_symlinks_description">Relink anything an earlier failed install left broken.</string>
    <string name="vmfix_fix_step_complete_packages_title">Finish half-installed packages</string>
    <string name="vmfix_fix_step_complete_packages_description">Needs root. Without it, packages still unpack and run, but stay marked as needing configuration.</string>
    <string name="vmfix_fix_step_verify_title">Verify</string>
    <string name="vmfix_fix_step_verify_description">Check the login hook, apt, pending upgrades, broken packages and broken symlinks.</string>
